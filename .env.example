# Copy to .env and fill in real values. See docs/ARCHITECTURE.md for details.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection string for the existing database (embeddings/faq/document/...).
# Include sslmode=require in the URL if the target requires TLS.
# Port 5433 matches docker-compose.yml's local Postgres (see README) — change
# to 5432 if you're pointing at a different/real Postgres instead.
DATABASE_URL=postgres://user:password@localhost:5433/bot_adapter

# Azure Bot Service / Bot Framework registration.
# Leave MICROSOFT_APP_ID/MICROSOFT_APP_PASSWORD empty for local development
# against the Bot Framework Emulator (unauthenticated mode). A real App ID is
# required once the bot is registered with Azure Bot Service / Teams.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=

# Azure OpenAI, consumed via the Vercel AI SDK (@ai-sdk/azure). Two separate
# resources, each with its own endpoint/key and its own subset of chat model
# deployments (see AZURE_CHAT_MODEL_REGION in
# src/constants/azure-openai.constants.ts for which model lives where).
# Embeddings (text-embedding-3-large) are only deployed on resource 2.

# Resource 1 — Australia East (AUE): gpt-4.1, gpt-5, o4-mini
AZURE_OPENAI_ENDPOINT=https://your-aue-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-aue-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_GPT_4_1_DEPLOYMENT=your-gpt-4.1-deployment-name
AZURE_OPENAI_GPT_5_DEPLOYMENT=your-gpt-5-deployment-name
AZURE_OPENAI_O4_MINI_DEPLOYMENT=your-o4-mini-deployment-name

# Resource 2 — Southeast Asia (SEA): gpt-4.1-mini, gpt-5.1, text-embedding-3-large
AZURE_OPENAI2_ENDPOINT=https://your-sea-resource-name.openai.azure.com
AZURE_OPENAI2_API_KEY=your-sea-azure-openai-api-key
AZURE_OPENAI2_API_VERSION=2024-10-21
AZURE_OPENAI2_GPT_4_1_MINI_DEPLOYMENT=your-gpt-4.1-mini-deployment-name
AZURE_OPENAI2_GPT_5_1_DEPLOYMENT=your-gpt-5.1-deployment-name
AZURE_OPENAI2_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# Chat model used when a caller doesn't request a specific one at runtime.
# One of: gpt-4.1 | gpt-5 | o4-mini | gpt-4.1-mini | gpt-5.1
AZURE_OPENAI_DEFAULT_CHAT_MODEL=gpt-4.1

# Azure Key Vault (optional). Leave all four empty/unset to disable — every
# secret below is then read from the vars above / your .env as normal. When
# set, they must ALL be set together. When enabled, DATABASE_URL,
# MICROSOFT_APP_PASSWORD, AZURE_OPENAI_API_KEY, and
# AZURE_OPENAI2_API_KEY are looked up in the vault first (as
# "database-url", "microsoft-app-password", "azure-openai-api-key",
# "azure-openai2-api-key") and only fall back to the values above if the
# vault doesn't have that particular secret. See docs/ARCHITECTURE.md for
# details.
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_TENANT_ID=
AZURE_KEY_VAULT_CLIENT_ID=
AZURE_KEY_VAULT_CLIENT_SECRET=
